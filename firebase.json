{
    "firestore":  {
                      "database":  "(default)",
                      "location":  "southamerica-east1",
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "hosting":  {
                    "public":  "public",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "headers":  [
                                    {
                                        "source":  "**",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache, no-store, must-revalidate"
                                                        }
                                                    ]
                                    }
                                ],
                        "rewrites":  []
                },
    "emulators":  {
                      "hosting":  {
                                      "host":  "0.0.0.0",
                                      "port":  5000
                                  }
                }
}
