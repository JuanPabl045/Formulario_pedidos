<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Molino Viejo - Historia</title>
  <meta name="description" content="Nuestra historia y valores.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" href="img/favicon.ico" type="image/x-icon">
  <style>
    body { font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background:#fff; }
    .hero{padding:40px 20px;text-align:center}
    .hero h1{font-size:2.4rem;color:#2d3436}
    .content{max-width:1000px;margin:30px auto}
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg"></nav>
  <header class="hero">
    <img src="img/logo.png" alt="Molino Viejo" style="height:70px">
    <h1>Molino Viejo</h1>
    <p>Carne y lácteos desde 1980</p>
  </header>
  <main class="content"></main>
  <footer class="footer"></footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="site-nav.js"></script>
</body>
</html>