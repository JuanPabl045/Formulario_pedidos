<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lácteos - Molino Viejo</title>
  <meta name="description" content="Productos lácteos frescos: quesos, mantequilla, yogurt y más."
  >
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" href="img/favicon.ico" type="image/x-icon">

  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(180deg,#fff,#f7f7f7); }
    .hero { padding:60px 20px; text-align:center; }
    .hero h1 { font-size:2.6rem; color:#2d3436; }
    .grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(240px,1fr)); gap:24px; max-width:1100px; margin:30px auto; }
    .card { background:white; padding:20px; border-radius:10px; box-shadow:0 10px 25px rgba(0,0,0,0.06); }
    .card img{ width:100%; height:160px; object-fit:cover; border-radius:8px; }
    @media(max-width:768px){ .hero h1{font-size:1.9rem;} }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg"></nav>
  <div class="hero">
    <img src="img/logo.png" alt="Molino Viejo" style="height:70px;">
    <h1>Lácteos Seleccionados</h1>
    <p>El mejor surtido de quesos y derivados</p>
  </div>
  <main>
    <section class="grid">
      <div class="card"><img src="img/queso.jpg" alt="Queso"></div>
      <div class="card"><img src="img/crema.jpg" alt="Crema"></div>
      <div class="card"><img src="img/yogurt.jpg" alt="Yogurt"></div>
      <div class="card"><img src="img/mantequilla.jpg" alt="Mantequilla"></div>
    </section>
  </main>
  <footer class="footer"></footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="site-nav.js"></script>
</body>
</html>