<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MolinoViejo.com - Carnes y Lácteos de Calidad</title>
  <meta name="description" content="Elige carnes o lácteos y realiza tu pedido online en Molino Viejo. Calidad y entrega confiable.">
  <link rel="canonical" href="https://molinoviejo.pe/landing.html">
  <meta property="og:title" content="MolinoViejo.com - Carnes y Lácteos de Calidad">
  <meta property="og:description" content="Elige carnes o lácteos y realiza tu pedido online en Molino Viejo. Calidad y entrega confiable.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://molinoviejo.pe/landing.html">
  <meta property="og:image" content="https://molinoviejo.pe/img/logo.png">
  <meta property="og:site_name" content="Molino Viejo">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="MolinoViejo.com - Carnes y Lácteos de Calidad">
  <meta name="twitter:description" content="Elige carnes o lácteos y realiza tu pedido online en Molino Viejo. Calidad y entrega confiable.">
  <meta name="twitter:image" content="https://molinoviejo.pe/img/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" href="img/favicon.ico" type="image/x-icon">
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* NAVBAR */
    .navbar {
      background: #2d3436;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
      padding: 10px 0;
    }

    .navbar-brand {
      color: #fff !important;
      font-weight: 800;
      font-size: 1.05rem;
    }

    .navbar-brand span { display: none; }

    .logo-animated {
      animation: logoFloat 3.8s ease-in-out infinite;
      transform-origin: center;
      will-change: transform;
    }

    .nav-link {
      color: rgba(255, 255, 255, 0.9) !important;
      font-weight: 600;
      margin: 0 6px;
      padding: 8px 14px;
      border-radius: 999px;
      transition: all 0.2s;
    }

    .nav-link:hover {
      color: #fff !important;
      background: rgba(255, 255, 255, 0.12);
      transform: translateY(-1px);
    }

    .nav-link.active {
      color: #fff !important;
      background: rgba(255, 255, 255, 0.18);
      border-bottom: none;
    }

    .navbar-toggler {
      border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .navbar-toggler-icon {
      filter: invert(1);
    }

    /* HERO SECTION */
    .hero-landing {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 20px;
      text-align: center;
    }

    .hero-content {
      max-width: 1200px;
      width: 100%;
    }

    .hero-landing h1 {
      font-size: 3.5rem;
      font-weight: 800;
      color: #2d3436;
      margin-bottom: 20px;
      letter-spacing: -1px;
    }

    .hero-landing p {
      font-size: 1.3rem;
      color: #636e72;
      margin-bottom: 60px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .logo-landing {
      height: 75px;
      width: auto;
      margin-bottom: 30px;
      filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.1));
    }

    @keyframes logoFloat {
      0%, 100% {
        transform: translateY(0) scale(1);
        filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.08));
      }
      50% {
        transform: translateY(-6px) scale(1.02);
        filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.12));
      }
    }

    @keyframes revealUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    body > nav,
    body > header,
    body > main,
    body > section,
    body > footer,
    body > .hero,
    body > .hero-landing,
    body > .container-fluid,
    body > .mv-header,
    body > .mv-search-wrap,
    body > .mv-cats-wrap,
    body > .mv-stats,
    body > .mv-main,
    body > #loginSection,
    body > #adminPanel {
      animation: revealUp 0.85s ease both;
    }

    body > nav { animation-delay: 0.02s; }
    body > header,
    body > .hero,
    body > .hero-landing,
    body > .mv-header { animation-delay: 0.08s; }
    body > .container-fluid,
    body > section:nth-of-type(1),
    body > .mv-search-wrap { animation-delay: 0.16s; }
    body > section:nth-of-type(2),
    body > .mv-cats-wrap,
    body > .mv-stats,
    body > main { animation-delay: 0.28s; }
    body > section:nth-of-type(3),
    body > footer,
    body > #loginSection,
    body > #adminPanel { animation-delay: 0.40s; }

    .section-title,
    .categoria-card,
    .valor-card,
    .producto-card,
    .producto-preview,
    .ubicacion-card,
    .selection-card,
    .filter-btn,
    .mv-group,
    .pcard,
    .footer-section {
      animation: revealUp 0.8s ease both;
    }

    @media (prefers-reduced-motion: reduce) {
      body > nav,
      body > header,
      body > main,
      body > section,
      body > footer,
      body > .hero,
      body > .hero-landing,
      body > .container-fluid,
      body > .mv-header,
      body > .mv-search-wrap,
      body > .mv-cats-wrap,
      body > .mv-stats,
      body > .mv-main,
      body > #loginSection,
      body > #adminPanel,
      .section-title,
      .categoria-card,
      .valor-card,
      .producto-card,
      .producto-preview,
      .ubicacion-card,
      .selection-card,
      .filter-btn,
      .mv-group,
      .pcard,
      .footer-section,
      .logo-animated {
        animation: none !important;
      }
    }

    /* CARDS DE SELECCIÓN */
    .selection-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 40px;
      max-width: 900px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .selection-card {
      background: white;
      border-radius: 20px;
      padding: 50px 40px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .selection-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: var(--card-color);
      transform: scaleX(0);
      transition: transform 0.4s;
    }

    .selection-card:hover::before {
      transform: scaleX(1);
    }

    .selection-card:hover {
      transform: translateY(-15px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    }

    .card-carnes {
      --card-color: #C42127;
    }

    .card-lacteos {
      --card-color: #3498db;
    }

    .selection-icon {
      font-size: 5rem;
      margin-bottom: 30px;
      transition: transform 0.4s;
    }

    .selection-card:hover .selection-icon {
      transform: scale(1.1) rotate(5deg);
    }

    .card-carnes .selection-icon {
      color: #C42127;
    }

    .card-lacteos .selection-icon {
      color: #3498db;
    }

    .selection-title {
      font-size: 2rem;
      font-weight: 700;
      color: #2d3436;
      margin-bottom: 15px;
      letter-spacing: -0.5px;
    }

    .selection-description {
      font-size: 1.1rem;
      color: #636e72;
      line-height: 1.6;
      text-align: center;
    }

    .selection-badge {
      position: absolute;
      top: 20px;
      right: 20px;
      background: var(--card-color);
      color: white;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* FOOTER */
    .footer {
      background: linear-gradient(to bottom, #2a2a2a, #1a1a1a);
      color: white;
      padding: 60px 20px 20px;
      margin-top: auto;
    }

    .footer-content {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 40px;